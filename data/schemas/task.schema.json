{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bhajanlal task record",
  "type": "object",
  "required": [
    "id",
    "prompt",
    "verifier",
    "provenance",
    "license",
    "split",
    "language",
    "difficulty"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "verifier": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "commit"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test"
      ]
    },
    "language": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    }
  }
}
